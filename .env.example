# Supabase Configuration (public by design — the anon key is not secret)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...your_anon_key_here

# API Gateway proxy base URL
# Set this to the value of the MedAiApiStack.ApiEndpoint CDK output.
# Example: https://abc123def.execute-api.ap-south-1.amazonaws.com
# This is the ONLY non-Supabase env var the SPA needs — no AI provider keys.
VITE_API_BASE_URL=https://your-api-gateway-id.execute-api.ap-south-1.amazonaws.com

# ── AI provider keys go into AWS Secrets Manager ONLY — never in this file ──
#
# Create them once with:
#   aws secretsmanager create-secret --name medai/gemini-api-key \
#     --secret-string "AIzaSy..." --region ap-south-1
#
#   aws secretsmanager create-secret --name medai/groq-api-key \
#     --secret-string "gsk_..." --region ap-south-1
#
#   aws secretsmanager create-secret --name medai/elevenlabs-api-key \
#     --secret-string "sk_..." --region ap-south-1
#
# Update a key without redeploying:
#   aws secretsmanager put-secret-value --secret-id medai/gemini-api-key \
#     --secret-string "NEW_KEY_VALUE"
#
# The following keys HAVE BEEN REMOVED from the Vite build entirely:
#   VITE_GEMINI_API_KEY    (was inlined into dist/ bundle — security gap closed)
#   VITE_GROQ_API_KEY      (was inlined into dist/ bundle — security gap closed)
#   VITE_ELEVENLABS_API_KEY (was inlined into dist/ bundle — security gap closed)